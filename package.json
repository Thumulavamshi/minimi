{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A chat agent with one tool (web search) and a dated memory, so it can say what it told you then and check whether it is still true now.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx src/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx eval/run.ts",
    "eval:live": "node --disable-warning=ExperimentalWarning --import tsx eval/live.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "groq-sdk": "^1.6.0",
    "marked": "^18.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
