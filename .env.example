# The only key the agent needs. Create one at https://platform.claude.com/settings/keys
# It pays for the model and for its built-in web search; there is no separate search key.
ANTHROPIC_API_KEY=

# ---- Optional settings (the defaults are shown) ----

# The model that answers and searches.
# AGENT_MODEL=claude-opus-5-5

# How hard the model thinks: low | medium | high | xhigh | max. Lower is faster.
# AGENT_EFFORT=medium

# The small model that summarises each finished turn for memory.
# DIGEST_MODEL=claude-haiku-5-5

# The most web searches a single answer may run.
# MAX_SEARCHES=8

# Set to "off" to stop the API retrying a safety-declined request on its fallback model.
# REFUSAL_FALLBACK=on

# PORT=3000
# DB_PATH=data/memory.db

# Pretend it is another moment (ISO timestamp), to try date questions without waiting days.
# AGENT_NOW=2026-11-12T10:00:00+05:30
