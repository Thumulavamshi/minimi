# The only key the agent needs. Create one at https://console.groq.com/keys
# It pays for the model and for its built-in web search; there is no separate search key.
GROQ_API_KEY=

# ---- Optional settings (the defaults are shown) ----

# The model that answers and searches. It must support Groq's built-in browser search
# (the GPT-OSS models: openai/gpt-oss-120b or the smaller, faster openai/gpt-oss-20b).
# AGENT_MODEL=openai/gpt-oss-120b

# How hard the model reasons: low | medium | high. Higher checks more but uses more
# of the free tier's per-minute token allowance.
# AGENT_EFFORT=low

# The small model that summarises each finished turn for memory.
# DIGEST_MODEL=openai/gpt-oss-20b

# PORT=3000
# DB_PATH=data/memory.db

# Print each search step the API reports to the server log, for troubleshooting.
# DEBUG_STREAM=1

# Pretend it is another moment (ISO timestamp), to try date questions without waiting days.
# AGENT_NOW=2026-11-12T10:00:00+05:30
